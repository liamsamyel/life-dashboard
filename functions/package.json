{
  "name": "lifeos-digest",
  "private": true,
  "version": "0.1.0",
  "description": "LifeOS daily Planner and bill email digest, run from GitHub Actions.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
