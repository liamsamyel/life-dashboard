# Copy this file to `.env` and fill in the values from your Firebase project:
#   Firebase Console -> Project settings -> Your apps -> Web app (</>) -> SDK setup
#
# Every value here is PUBLIC by design (the web SDK ships them to the
# browser). Security comes from Firestore security rules, not from hiding
# these. Never put a service-account key or server SDK config in this file.

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
